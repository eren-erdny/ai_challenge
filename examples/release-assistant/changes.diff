diff --git a/examples/file-assistant/result/src/export.js b/examples/file-assistant/result/src/export.js
new file mode 100644
index 0000000..6d02b19
--- /dev/null
+++ b/examples/file-assistant/result/src/export.js
@@ -0,0 +1,11 @@
+// TaskDesk teaching fixture: export authorization and metadata, not a PDF renderer.
+function exportTasks(plan, format) {
+  if (!['csv', 'pdf'].includes(format)) {
+    return { status: 400, error: 'UNSUPPORTED_FORMAT' };
+  }
+  if (format === 'pdf' && plan !== 'Pro') {
+    return { status: 403, error: 'PLAN_REQUIRED' };
+  }
+  return { status: 200, format, filename: `tasks.${format}` };
+}
+module.exports = { exportTasks };
diff --git a/examples/file-assistant/result/src/ui.js b/examples/file-assistant/result/src/ui.js
new file mode 100644
index 0000000..44e9d9a
--- /dev/null
+++ b/examples/file-assistant/result/src/ui.js
@@ -0,0 +1,8 @@
+const { handleExport } = require('./api');
+
+function downloadExport(user, format) {
+  const response = handleExport(user, { format });
+  if (response.status !== 200) return { message: response.error };
+  return { download: response.filename };
+}
+module.exports = { downloadExport };
