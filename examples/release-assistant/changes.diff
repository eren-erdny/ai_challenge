+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/eren-erdny/ai_challenge/projects/deepseek-client/agent"
+)
+
+type projectContextTools struct {
+	calls int
+	fail  bool
+}
+
+func (*projectContextTools) Definitions() []agent.ToolDefinition {
+	return []agent.ToolDefinition{{Type: "function", Function: agent.ToolFunction{Name: "git__git_status", Parameters: []byte(`{"type":"object"}`)}}}
+}
+func (p *projectContextTools) Execute(_ context.Context, name, args string) (string, error) {
+	p.calls++
+	if name != "git__git_status" || args != "{}" {
+		return "", errors.New("unexpected call")
+	}
+	if p.fail {
+		return "", errors.New("MCP unavailable")
+	}
+	branch := "## current-branch"
+	if p.calls > 1 {
+		branch = "## new-branch"
+	}
+	b, _ := json.Marshal(map[string]any{"text": branch + "\n M private-path.md", "truncated": false})
+	return string(b), nil
+}
+func TestProjectContextFreshAndCitableDespiteRetrievalCutoffs(t *testing.T) {
+	tools := &projectContextTools{}
+	for _, branch := range []string{"current-branch", "new-branch"} {
+		evidence, err := projectHelpContext(context.Background(), tools, t.TempDir(), `{"results":[],"no_evidence":true,"min_similarity":0.99,"min_rerank_score":100}`, io.Discard)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(evidence, "private-path") {
+			t.Fatal("changed paths should not enter branch evidence")
+		}
+		wire := `{"status":"answered","claims":[{"text":"branch","quote_ids":["q1"]}],"quotes":[{"id":"q1","chunk_id":"runtime-git-status","text":"Current Git status: ## ` + branch + `"}],"clarification":""}`
+		answer, err := agent.ValidateGroundedAnswer(wire, evidence)
+		if err != nil || answer.Sources[0].Source != "mcp://git/git_status" {
+			t.Fatalf("answer=%+v err=%v", answer, err)
+		}
+	}
+	if tools.calls != 2 {
+		t.Fatal("stale context reused")
+	}
+	tools.fail = true
+	if _, err := projectHelpContext(context.Background(), tools, t.TempDir(), `{"results":[]}`, io.Discard); err == nil {
+		t.Fatal("failed MCP accepted")
+	}
+}
+func TestBuiltinGitConfigurationValidation(t *testing.T) {
+	repo := t.TempDir()
+	good, _ := json.Marshal(map[string]any{"servers": []any{map[string]string{"name": "git", "transport": "builtin-git", "repo": repo}}})
+	if _, err := decodeMCPRegistry(good); err != nil {
+		t.Fatal(err)
+	}
+	for _, repo := range []string{"", "relative"} {
+		b, _ := json.Marshal(map[string]any{"servers": []any{map[string]string{"name": "git", "transport": "builtin-git", "repo": repo}}})
+		if _, err := decodeMCPRegistry(b); err == nil {
+			t.Fatal("relative repository accepted")
+		}
+	}
+}
+func TestProjectModeRejectsOtherMCPRouting(t *testing.T) {
+	t.Setenv("DEEPSEEK_PROJECT_ROOT", t.TempDir())
+	t.Setenv("GIT_MCP_URL", "https://example.invalid/mcp")
+	if _, err := loadMCPRegistry(); err == nil {
+		t.Fatal("project mode accepted different Git server")
+	}
+}
+
+func TestProjectSourcesMustMatchBoundProject(t *testing.T) {
+	root := t.TempDir()
+	valid := []string{filepath.Join(root, "README.md"), filepath.Join(root, "docs")}
+	if err := validateProjectSources(root, valid); err != nil {
+		t.Fatal(err)
+	}
+	for _, sources := range [][]string{valid[:1], {t.TempDir()}, append(append([]string(nil), valid...), t.TempDir())} {
+		if err := validateProjectSources(root, sources); err == nil {
+			t.Fatal("unrelated or incomplete project base accepted")
+		}
+	}
+}
diff --git a/projects/deepseek-client/project_help.go b/projects/deepseek-client/project_help.go
new file mode 100644
index 0000000..4e1625e
--- /dev/null
+++ b/projects/deepseek-client/project_help.go
@@ -0,0 +1,104 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/eren-erdny/ai_challenge/projects/deepseek-client/agent"
+)
+
+func projectHelpQuestion(text string) (string, bool) {
+	fields := strings.Fields(text)
+	if len(fields) < 2 || fields[0] != "/help" {
+		return text, false
+	}
+	return strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(text), "/help")), true
+}
+func isProjectHelp(text string) bool {
+	_, ok := projectHelpQuestion(text)
+	return ok
+}
+
+func projectHelpContext(ctx context.Context, tools agent.ToolExecutor, project, evidence string, out io.Writer) (string, error) {
+	if tools == nil {
+		return "", errors.New("Git MCP is not connected")
+	}
+	registered := false
+	for _, definition := range tools.Definitions() {
+		if definition.Function.Name == "git__git_status" {
+			registered = true
+			break
+		}
+	}
+	if !registered {
+		return "", errors.New("local git__git_status is not available")
+	}
+	callCtx, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	// Fixed application-owned read-only call, not a model-selected operation.
+	value, err := tools.Execute(callCtx, "git__git_status", "{}")
+	if err != nil {
+		return "", err
+	}
+	var status struct {
+		Text      string `json:"text"`
+		Truncated bool   `json:"truncated"`
+	}
+	if json.Unmarshal([]byte(value), &status) != nil || status.Truncated {
+		return "", errors.New("invalid or truncated Git MCP result")
+	}
+	line := strings.SplitN(strings.TrimSpace(status.Text), "\n", 2)[0]
+	if !strings.HasPrefix(line, "## ") {
+		return "", errors.New("Git MCP result has no branch header")
+	}
+	text := "Project directory: " + filepath.ToSlash(project) + "\nCurrent Git status: " + line
+	var wire map[string]json.RawMessage
+	if json.Unmarshal([]byte(evidence), &wire) != nil || wire["results"] == nil {
+		return "", errors.New("project retrieval did not provide evidence")
+	}
+	// Runtime context has its own provenance; it does not receive fake retrieval scores.
+	runtime, _ := json.Marshal([]map[string]string{{"source": "mcp://git/git_status", "section": "Current repository branch", "chunk_id": "runtime-git-status", "text": text}})
+	wire["context_results"] = runtime
+	wire["no_evidence"] = json.RawMessage("false")
+	encoded, err := json.Marshal(wire)
+	if err != nil {
+		return "", err
+	}
+	fmt.Fprintf(out, "[MCP git__git_status: %s]\n", line)
+	return string(encoded), nil
+}
+
+// Project mode must not silently combine a different knowledge base with this Git clone.
+func validateProjectSources(project string, sources []string) error {
+	root, err := filepath.Abs(project)
+	if err != nil {
+		return err
+	}
+	hasReadme, hasDocs := false, false
+	for _, source := range sources {
+		absolute, err := filepath.Abs(source)
+		if err != nil {
+			return err
+		}
+		relative, err := filepath.Rel(root, absolute)
+		if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) {
+			return errors.New("selected knowledge base contains sources outside the project")
+		}
+		if relative == "README.md" {
+			hasReadme = true
+		}
+		if relative == "docs" {
+			hasDocs = true
+		}
+	}
+	if !hasReadme || !hasDocs {
+		return errors.New("select the project README + docs knowledge base")
+	}
+	return nil
+}
